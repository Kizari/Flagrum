<Window x:Class="Flagrum.Host.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:Flagrum.Host.Shell"
        mc:Ignorable="d"
        Title="Flagrum"
        WindowStartupLocation="Manual"
        Background="#181512"
        Width="1680"
        Height="1024"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        CanResize="True">

    <!-- Window border -->
    <Border Background="#181512">
        
        <!-- Layout -->
        <Grid Name="MainGrid"
              Margin="2"
              RowDefinitions="42,*">
            
            <!-- Title Bar -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="45,*,Auto,Auto,Auto"
                  Background="#181512"
                  WindowDecorationProperties.ElementRole="TitleBar">
                
                <!-- Logo -->
                <Svg Grid.Column="0"
                     Path="avares://Flagrum/Assets/logo_white.svg"
                     Width="20"
                     Height="20"
                     Margin="2, 0, 0, 2"
                     CurrentColor="#837363" />
                
                <!-- Application name -->
                <TextBlock Grid.Column="1"
                           Text="Flagrum"
                           FontFamily="{StaticResource Play}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="#837363"
                           Padding="0 5 15 8"/>
                
                <!-- Minimize button -->
                <shell:PlasmaShellButton Grid.Column="2"
                                         Icon="WindowMinimize"
                                         WindowDecorationProperties.ElementRole="MinimizeButton"
                                         Click="OnMinimize"/>
                
                <!-- Maximize button -->
                <shell:PlasmaShellButton Grid.Column="3"
                                         Icon="{Binding WindowState, 
                                                        RelativeSource={RelativeSource AncestorType=Window},
                                                        Converter={StaticResource WindowStateToSystemIconConverter}}"
                                         Margin="15 0"
                                         WindowDecorationProperties.ElementRole="MaximizeButton"
                                         Click="OnMaximize"/>
                
                <!-- Close button -->
                <shell:PlasmaShellButton Grid.Column="4"
                                         Icon="WindowClose"
                                         HoverBackground="IndianRed"
                                         Margin="0 0 8 0"
                                         WindowDecorationProperties.ElementRole="CloseButton"
                                         Click="OnClose"/>
            </Grid>
            
            <!-- Content is added in codebehind -->
        </Grid>
    </Border>

</Window>