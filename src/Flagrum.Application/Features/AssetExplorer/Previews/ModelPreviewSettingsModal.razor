@using Flagrum.Application.Features.AssetExplorer.Data
@inject AppStateService AppState
@inject IStringLocalizer<ModelPreviewSettingsModal> Localizer
@inject IStringLocalizer<App> AppLocalizer
@inject IConfiguration Configuration

<AutosizeModal @ref="Modal">
    <HeaderView>
        <span class="text-grey-300 flex-grow">@Localizer["Title"]</span>
        <span class="material-icons cursor-pointer" @onclick="Cancel">close</span>
    </HeaderView>
    <BodyView>
        <div style="width: 300px;">
            <div class="row mb-3">
                <h5 class="text-accent1-200">Key Bindings</h5>
            </div>
            <div class="row mb-3">
                <label class="text-right pr-3" style="width: 100px">Left Click</label>
                <select @bind="LeftClickAction" class="input bg-dark-550" style="width: 150px;">
                    @foreach (var key in Enum.GetValues<Viewport3D.Control>())
                    {
                        <option value="@key">@key</option>
                    }
                </select>
            </div>
            <div class="row mb-3">
                <label class="text-right pr-3" style="width: 100px">Middle Click</label>
                <select @bind="MiddleClickAction" class="input bg-dark-550" style="width: 150px;">
                    @foreach (var key in Enum.GetValues<Viewport3D.Control>())
                    {
                        <option value="@key">@key</option>
                    }
                </select>
            </div>
            <div class="row mb-8">
                <label class="text-right pr-3" style="width: 100px">Right Click</label>
                <select @bind="RightClickAction" class="input bg-dark-550" style="width: 150px;">
                    @foreach (var key in Enum.GetValues<Viewport3D.Control>())
                    {
                        <option value="@key">@key</option>
                    }
                </select>
            </div>
            <div class="row mb-3">
                <h5 class="text-accent1-200">Texture Settings</h5>
            </div>
            <div class="row mb-8">
                <label class="text-right pr-3" style="width: 100px">Texture Fidelity</label>
                <EditForm Model="this">
                    <EnumSelect TEnum="ModelViewerTextureFidelity" @bind-Value="TextureFidelity"/>
                </EditForm>
            </div>
            <Button Icon="save" Text=@AppLocalizer["Save"] OnClick="Save"/>
        </div>
    </BodyView>
</AutosizeModal>

@code
{
    [CascadingParameter] public ModelPreview Parent { get; set; }

    private AutosizeModal Modal { get; set; }

    private Viewport3D.Control LeftClickAction { get; set; }
    private Viewport3D.Control MiddleClickAction { get; set; }
    private Viewport3D.Control RightClickAction { get; set; }
    private ModelViewerTextureFidelity TextureFidelity { get; set; }

    public void Open()
    {
        LeftClickAction = Configuration.TryGet<Viewport3D.Control>(
            StateKey.ViewportLeftClickAction, out var left) ? left : Viewport3D.Control.Pan;
        MiddleClickAction = Configuration.TryGet<Viewport3D.Control>(
            StateKey.ViewportMiddleClickAction, out var middle) ? middle : Viewport3D.Control.Rotate;
        RightClickAction = Configuration.TryGet<Viewport3D.Control>(
            StateKey.ViewportRightClickAction, out var right) ? right : Viewport3D.Control.Dolly;
        
        var textureFidelity = Configuration.Get<int>(StateKey.ViewportTextureFidelity);
        TextureFidelity = textureFidelity == -1 ? ModelViewerTextureFidelity.Low : (ModelViewerTextureFidelity)textureFidelity;

        AppState.IsModalOpen = true;
        Modal.Open();
    }

    private void Cancel()
    {
        Modal.Close();
        AppState.IsModalOpen = false;
    }

    private void Save()
    {
        Configuration.Set(StateKey.ViewportLeftClickAction, LeftClickAction);
        Configuration.Set(StateKey.ViewportMiddleClickAction, MiddleClickAction);
        Configuration.Set(StateKey.ViewportRightClickAction, RightClickAction);
        Configuration.Set(StateKey.ViewportTextureFidelity, (int)TextureFidelity);

        Cancel();

        Parent.CallStateHasChanged();
    }
}