@using System.IO
@using Flagrum.Core.Graphics.Textures
@using Flagrum.Core.Graphics.Textures.Luminous
@using Flagrum.Core.Graphics.Textures.NvidiaTextureTools
@inject IProfileService Profile

<div class="flex-grow flex flex-col">
    <div class="flex-grow flex flex-row items-center">
        @if (CurrentIndex > 0)
        {
            <span class="material-icons text-5xl text-grey-400 cursor-pointer ml-6 select-none"
                  @onclick="() => SetImage(CurrentIndex - 1)">arrow_back_ios</span>
        }
        else
        {
            <span
                class="material-icons text-5xl text-grey-400 cursor-pointer ml-6 select-none invisible">arrow_back_ios</span>
        }
        <img alt="Texture Preview" src="images/@Profile.Current.Id/@ImageName" class="mx-auto select-none"
             style="max-width: 70%; max-height: 90%;"/>
        @if (CurrentIndex < ImageCount - 1)
        {
            <span class="material-icons text-5xl text-grey-400 cursor-pointer mr-6 select-none"
                  @onclick="() => SetImage(CurrentIndex + 1)">arrow_forward_ios</span>
        }
        else
        {
            <span class="material-icons text-5xl text-grey-400 cursor-pointer mr-6 select-none invisible">arrow_forward_ios</span>
        }
    </div>

    @if (ImageCount > 1)
    {
        <div class="text-center mb-6">
            <span class="font-display text-grey-400 text-lg">Image @(CurrentIndex + 1) / @ImageCount</span>
        </div>
    }
</div>

@code
{
    private IAssetExplorerNode _previousItem;

    [Parameter] public IAssetExplorerNode Item { get; set; }

    private string ImageName { get; set; } = "asset_preview.jpg";

    private byte[] Texture { get; set; }
    private int CurrentIndex { get; set; }
    private uint ImageCount { get; set; } = 1;

    protected override void OnParametersSet()
    {
        if (_previousItem != Item)
        {
            _previousItem = Item;
            Texture = Item.Data;
            SetImage(0);
        }
    }

    private void SetImage(int index)
    {
        // var texture = BlackTexture.Deserialize(Texture);
        // ImageCount = texture.ImageData[0].ArrayCount;
        // CurrentIndex = index;
        // var path = Path.Combine(Profile.ImagesDirectory, "asset_preview.jpg");
        // using var surfaceSet = new SurfaceSet(texture);
        // surfaceSet.SaveJpg(0, 0, path);
        // ImageName = $"asset_preview.jpg?v={CultureHelper.GetVersionTimestamp()}"; // Forces img update on state change
        // StateHasChanged();
        // return;


        var texture = new BlackTexture(Texture);
        ImageCount = texture.ImageHeader.ArrayCount;
        CurrentIndex = index;

        var path = Path.Combine(Profile.ImagesDirectory, "asset_preview.jpg");
        using var surfaceSet = new NvttSurfaceSet(texture);
        surfaceSet.SaveJpg(0, 0, path);
        //texture.Save(path, ImageFormat.Jpeg);

        ImageName = $"asset_preview.jpg?v={CultureHelper.GetVersionTimestamp()}"; // Forces img update on state change
        StateHasChanged();
    }
}